{
	"name": "manuspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '@manuspace/api' --filter '@manuspace/collab' --filter '@manuspace/web' dev",
		"build": "bun run --filter '@manuspace/web' build",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun run --filter '*' test",
		"e2e:call": "node --experimental-strip-types --disable-warning=ExperimentalWarning e2e/call.e2e.ts",
		"docs:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs-pdf.ts",
		"e2e:editor": "node --experimental-strip-types --disable-warning=ExperimentalWarning e2e/editor.e2e.ts",
		"db:generate": "bun run --filter '@manuspace/db' generate",
		"db:migrate": "bun run --filter '@manuspace/db' migrate",
		"infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
		"infra:down": "docker compose -f infra/docker-compose.dev.yml down"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"marked": "^18.0.14",
		"mermaid": "^12.0.0",
		"pdf-lib": "^1.17.1",
		"playwright": "^1.63.0",
		"railway": "^3.11.0",
		"typescript": "^7.0.2"
	}
}
