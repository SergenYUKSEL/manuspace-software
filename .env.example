# Copier en .env à la racine : cp .env.example .env

# --- Commun api + collab ---
DATABASE_URL=postgres://manuspace:manuspace@localhost:5434/manuspace
# Secret partagé pour les tickets de connexion au serveur collab (>= 32 caractères).
# Générer : bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
COLLAB_TICKET_SECRET=change-me-change-me-change-me-change-me

# --- API (serveur 1) ---
NODE_ENV=development
PORT=3000
# Clé AES-256 qui chiffre les secrets 2FA en base (32 octets en base64).
# Générer : bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2LW8=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=manuspace
S3_ACCESS_KEY_ID=manuspace
S3_SECRET_ACCESS_KEY=manuspace-secret
# Local (RustFS) : us-east-1 et URLs de chemin ; bucket Railway : auto et virtual-hosted.
S3_REGION=us-east-1
S3_VIRTUAL_HOSTED_STYLE=false

# --- Collab (serveur 2) ---
# En local, le serveur collab écoute sur COLLAB_PORT (PORT est pris par l'API).
COLLAB_PORT=3001

# --- Front (exposé au navigateur, préfixe VITE_ obligatoire) ---
VITE_COLLAB_URL=ws://localhost:3001
